@inherits LayoutComponentBase

<AuthProvider>
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>

    <div id="blazor-error-ui" data-nosnippet>
        Ocurrió un error, por favor reinicie el sistema
        <a href="." class="reload">Reload</a>
