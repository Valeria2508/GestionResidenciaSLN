@inject NavigationManager Navigation

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">
            <i class="bi bi-building"></i>
            Gestion Residencial
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menu">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <NavLink class="nav-link" href="/">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </NavLink>
                </li>

                @if (Auth?.IsAdmin == true)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/conjunto">
                            <i class="bi bi-buildings"></i> Conjuntos
                        </NavLink>
                    </li>
                    <li class="nav-item px-3">
                        <NavLink class="nav-link" href="/apartamentos">Apartamentos</NavLink>
                    </li>
                    <li class="nav-item px-3">
                        <NavLink class="nav-link" href="/cuota">Cuota Admin</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/torres">Torres</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/parqueadero">Parqueaderos</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/zonasComunes">Zonas Comunes</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/visitantes">Visitantes</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/mensajeria">Mensajería</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/pagos">Pagos</NavLink>
                    </li>
                }

                @if (Auth?.IsAdmin == true || isUser)
                {
                    <li class="nav-item px-3">
                        <NavLink class="nav-link" href="/auditoriaLogin">Auditoría Login</NavLink>
                    </li>
                    <li class="nav-item px-3">
                        <NavLink class="nav-link" href="/bitacoraVigilancia">Bitácora Vigilancia</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/reservas">Reservas</NavLink>
                    </li>
                }
            </ul>

            <div class="d-flex align-items-center text-light">
                <i class="bi bi-person-circle me-2" style="font-size:1.25rem"></i>
                <div class="me-3">
                    <div>@(Auth?.CurrentUsername ?? "Invitado")</div>
                    <div class="small text-muted">@(Auth?.CurrentRole ?? "-")</div>
                </div>
                <button class="btn btn-outline-light btn-sm" @onclick="Logout">Cerrar sesión</button>
            </div>
        </div>
    </div>
</nav>

@code {
    [CascadingParameter]
    private AuthProvider? Auth { get; set; }

    private bool isUser => Auth?.CurrentRole == "Usuario"
                        || Auth?.CurrentRole == "Residente"
                        || Auth?.CurrentRole == "Porteria";

    private async Task Logout()
    {
        if (Auth != null)
            await Auth.LogoutAsync();

        Navigation.NavigateTo("/login", forceLoad: true);
    }
}