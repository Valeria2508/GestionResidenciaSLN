@page "/conjunto"
@using GestionResidenciaApi.DTOs
@inject HttpClient Http
@using Microsoft.JSInterop
@inject IJSRuntime JS

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Gestión Conjuntos</h4>
        <button class="btn btn-light btn-sm" @onclick="PrepararNuevo">
            <i class="bi bi-plus-circle"></i> + Nuevo conjunto
        </button>
    </div>

    <div class="card-body">
        @* --- FORMULARIO DE EDICIÓN / CREACIÓN --- *@
        @* @if (mostrandoFormulario)
        {
            <div class="alert alert-light border-primary shadow-sm mb-4">
                <h5>@(esEdicion ? "Editar Auditoria Login" : "Nueva Auditoria Login")</h5>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Usuario ID</label>
                        <input type="number" class="form-control" @bind="modelo.UsuarioId" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Número</label>
                        <input type="text" class="form-control" @bind="modelo.Numero" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Tipo</label>
                        <input type="text" class="form-control" @bind="modelo.Tipo" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Área</label>
                        <input type="text" class="form-control" @bind="modelo.Area" />
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-success btn-sm" @onclick="Guardar">Guardar</button>
                    <button class="btn btn-secondary btn-sm" @onclick="() => mostrandoFormulario = false">Cancelar</button>
                </div>
            </div>
        } *@

        @if (conjunto == null)
        {
            <div class="text-center">
                <div class="spinner-border text-primary" role="status"></div>
                <p>Conectando con la API...</p>
            </div>
        }
        else if (conjunto.Count == 0)
        {
            <div class="alert alert-warning">
                La API respondió, pero la tabla está vacía en la base de datos.
            </div>
        }
        else
        {
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Direccion</th>
                        <th>Ciudad</th>
                        <th>NIT</th>
                        <th>Telefono</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in conjunto)
                    {
                        <tr>
                            <td>@item.Nombre</td>
                            <td>@item.Direccion</td>
                            <td>@item.Ciudad</td>
                            <td>@item.NIT</td>
                            <td>@item.Telefono</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => PrepararEdicion(item)">
                                    Editar
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(item.Conjunto)">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<ConjuntoCreateDTO>? conjunto;
    private ConjuntoCreateDTO modelo = new();
    private bool mostrandoFormulario = false;
    private bool esEdicion = false;
    private int idEdicion = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            conjunto = await Http.GetFromJsonAsync<List<ConjuntoCreateDTO>>("api/Conjunto");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error de conexión: {ex.Message}");
            conjunto = new List<ConjuntoCreateDTO>();
        }
    }

    private void PrepararNuevo()
    {
        modelo = new ConjuntoCreateDTO();
        esEdicion = false;
        mostrandoFormulario = true;
    }

    private void PrepararEdicion(ConjuntoCreateDTO item)
    {
        // Clonamos el objeto para no editar la lista directamente
        modelo = new ConjuntoCreateDTO
        {
            ConjuntoId = item.ConjuntoId,
            Nombre = item.Nombre,
            Direccion = item.Direccion,
            Ciudad = item.Ciudad,
            NIT = item.NIT,
            Telefono = item.Telefono
        };
    }

    private async Task Guardar()
    {
        try
        {
            if (esEdicion)
            {
                // PUT: api/Conjunto/5
                await Http.PutAsJsonAsync($"api/Conjunto/{idEdicion}", modelo);
            }
            else
            {
                // POST: api/Conjunto
                await Http.PostAsJsonAsync("api/Conjunto", modelo);
            }
            
            mostrandoFormulario = false;
            await CargarDatos(); // Refrescamos la tabla
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar: {ex.Message}");
        }
    }

    private async Task Eliminar(int id)
    {
        // Usamos JS para confirmar la eliminación
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "¿Seguro que deseas eliminar este registro?");
        if (confirmado)
        {
            try
            {
                await Http.DeleteAsync($"api/Apartamentos/{id}");
                await CargarDatos(); // Refrescamos la tabla
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al eliminar: {ex.Message}");
            }
        }
    }
}