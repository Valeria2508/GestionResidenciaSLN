@page "/"
@page "/login"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using GestionResidenciaFront.Components.Auth
@using GestionResidenciaFront.Components.Layout
@layout LoginLayout
@inject GestionResidenciaFront.Services.AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="login-page">
    <div class="login-card">

        <div class="login-left">
            <div class="login-logo">
                <div class="login-logo-icon">
                    <i class="bi bi-building"></i>
                </div>
                <span class="login-logo-text">Gestión Residencial</span>
            </div>
            <div class="login-headline">
                <h1>Bienvenido<br />de nuevo</h1>
                <p>Accede al sistema de administración y control de tu residencia.</p>
            </div>
            <div class="login-badges">
                <div class="login-badge"><i class="bi bi-shield-check"></i> Acceso seguro</div>
                <div class="login-badge"><i class="bi bi-people"></i> Multi-rol</div>
                <div class="login-badge"><i class="bi bi-clock"></i> Disponible 24/7</div>
            </div>
        </div>

        <div class="login-right">
            <p class="login-title">Iniciar sesión</p>
            <p class="login-sub">Ingresa tus credenciales para continuar</p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="login-error">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    @errorMessage
                    <button class="login-error-close" @onclick="() => errorMessage = null">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            }

            <div class="login-field">
                <label class="login-label">Usuario</label>
                <div class="login-input-wrap">
                    <i class="bi bi-person login-input-icon"></i>
                    <input class="login-input"
                           type="text"
                           placeholder="Tu usuario"
                           @bind="username"
                           @bind:event="oninput"
                           disabled="@isProcessing" />
                </div>
            </div>

            <div class="login-field">
                <label class="login-label">Contraseña</label>
                <div class="login-input-wrap">
                    <i class="bi bi-lock login-input-icon"></i>
                    <input class="login-input"
                           type="password"
                           placeholder="••••••••"
                           @bind="password"
                           @bind:event="oninput"
                           disabled="@isProcessing"
                           @onkeydown="HandleKeyDown" />
                </div>
            </div>

            <button class="login-btn" @onclick="HandleLogin" disabled="@isProcessing">
                @if (isProcessing)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                    <span>Entrando...</span>
                }
                else
                {
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Entrar</span>
                }
            </button>

            <hr class="login-divider" />
            <p class="login-roles-label">Roles disponibles</p>
            <div class="login-roles">
                <span class="login-role-pill">Administrador</span>
                <span class="login-role-pill">Portería</span>
                <span class="login-role-pill">Residente</span>
                <span class="login-role-pill">Usuario</span>
            </div>
        </div>

    </div>
</div>

<style>
    .login-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f0f4f8;
        padding: 2rem;
    }

    .login-card {
        display: flex;
        width: 100%;
        max-width: 860px;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 40px rgba(0,0,0,0.10);
    }

    /* ── Panel izquierdo ── */
    .login-left {
        width: 42%;
        background: #185FA5;
        padding: 2.5rem 2rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
    }

        .login-left::before {
            content: '';
            position: absolute;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: #378ADD;
            opacity: 0.20;
            top: -60px;
            right: -70px;
        }

        .login-left::after {
            content: '';
            position: absolute;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: #0C447C;
            opacity: 0.35;
            bottom: 40px;
            left: -40px;
        }

    .login-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        position: relative;
        z-index: 1;
    }

    .login-logo-icon {
        width: 38px;
        height: 38px;
        background: rgba(255,255,255,0.15);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        color: #fff;
    }

    .login-logo-text {
        font-size: 13px;
        font-weight: 500;
        color: #B5D4F4;
        letter-spacing: 0.03em;
    }

    .login-headline {
        position: relative;
        z-index: 1;
    }

        .login-headline h1 {
            font-size: 28px;
            font-weight: 600;
            color: #fff;
            margin: 0 0 10px;
            line-height: 1.2;
        }

        .login-headline p {
            font-size: 13px;
            color: #85B7EB;
            margin: 0;
            line-height: 1.6;
        }

    .login-badges {
        display: flex;
        flex-direction: column;
        gap: 10px;
        position: relative;
        z-index: 1;
    }

    .login-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: #B5D4F4;
    }

        .login-badge i {
            color: #85B7EB;
        }

    /* ── Panel derecho ── */
    .login-right {
        width: 58%;
        background: #fff;
        padding: 2.5rem 2.25rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .login-title {
        font-size: 20px;
        font-weight: 600;
        color: #1a1a2e;
        margin: 0 0 4px;
    }

    .login-sub {
        font-size: 13px;
        color: #6b7280;
        margin: 0 0 1.5rem;
    }

    /* Error */
    .login-error {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #FEF2F2;
        border: 1px solid #FECACA;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 13px;
        color: #991B1B;
        margin-bottom: 1rem;
        position: relative;
    }

    .login-error-close {
        background: none;
        border: none;
        color: #991B1B;
        cursor: pointer;
        margin-left: auto;
        font-size: 16px;
        line-height: 1;
        padding: 0;
    }

    /* Campos */
    .login-field {
        margin-bottom: 1rem;
    }

    .login-label {
        display: block;
        font-size: 11px;
        font-weight: 600;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        margin-bottom: 6px;
    }

    .login-input-wrap {
        position: relative;
    }

    .login-input-icon {
        position: absolute;
        left: 11px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 15px;
        color: #9ca3af;
        pointer-events: none;
    }

    .login-input {
        width: 100%;
        box-sizing: border-box;
        height: 42px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #f9fafb;
        color: #111827;
        font-size: 14px;
        padding: 0 12px 0 36px;
        outline: none;
        transition: border-color 0.15s, background 0.15s;
    }

        .login-input:focus {
            border-color: #185FA5;
            background: #fff;
        }

        .login-input:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    /* Botón */
    .login-btn {
        width: 100%;
        height: 42px;
        background: #185FA5;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: background 0.15s;
    }

        .login-btn:hover:not(:disabled) {
            background: #0C447C;
        }

        .login-btn:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

    /* Divider y roles */
    .login-divider {
        border: none;
        border-top: 1px solid #f3f4f6;
        margin: 1.5rem 0 1rem;
    }

    .login-roles-label {
        font-size: 11px;
        color: #9ca3af;
        margin: 0 0 8px;
    }

    .login-roles {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .login-role-pill {
        font-size: 11px;
        padding: 3px 10px;
        border-radius: 99px;
        background: #f3f4f6;
        color: #6b7280;
        border: 1px solid #e5e7eb;
    }

    /* Responsive */
    @@media (max-width: 640px) {
        .login-card {
            flex-direction: column;
        }

        .login-left, .login-right {
            width: 100%;
        }

        .login-left {
            padding: 2rem 1.5rem;
        }

        .login-headline h1 {
            font-size: 22px;
        }
    }
</style>

@code {
    private string username = "";
    private string password = "";
    private bool isProcessing = false;
    private string? errorMessage;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await HandleLogin();
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Por favor ingresa usuario y contraseña.";
            return;
        }

        isProcessing = true;
        errorMessage = null;

        try
        {
            var result = AuthService.Login(username, password);

            if (result != null)
            {
                var ruta = result.Rol switch
                {
                    "Administrador" => "/dashboard",
                    "Porteria" => "/porteria",
                    "Residente" => "/residente",
                    _ => "/dashboard"
                };

                Navigation.NavigateTo(ruta);
            }
            else
            {
                errorMessage = "Usuario o contraseña incorrectos.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al iniciar sesión: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }

        await Task.CompletedTask;
    }
}