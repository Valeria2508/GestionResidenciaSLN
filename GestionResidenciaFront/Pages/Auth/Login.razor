@page "/"
@page "/login"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using GestionResidenciaFront.Components.Auth
@using GestionResidenciaFront.Components.Layout
@layout LoginLayout
@inject GestionResidenciaFront.Services.AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="login-page d-flex align-items-center justify-content-center">
    <div class="login-card shadow-lg">
        <div class="login-card-left p-4 text-white">
            <h2 class="mb-3">Bienvenido</h2>
            <p class="small">Inicia sesión para acceder al sistema de gestión residencial.</p>
            <div class="d-none d-md-block mt-4">
                <i class="bi bi-people-fill display-3"></i>
            </div>
        </div>
        <div class="login-card-body p-4">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Usuario</label>
                <input class="form-control form-control-lg"
                       @bind="username"
                       @bind:event="oninput"
                       placeholder="Usuario"
                       disabled="@isProcessing" />
            </div>

            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <input type="password"
                       class="form-control form-control-lg"
                       @bind="password"
                       @bind:event="oninput"
                       placeholder="Contraseña"
                       disabled="@isProcessing"
                       @onkeydown="HandleKeyDown" />
            </div>

            <button type="button"
                    class="btn btn-primary btn-lg w-100"
                    @onclick="HandleLogin"
                    disabled="@isProcessing">
                @if (isProcessing)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Entrando...</span>
                }
                else
                {
                    <span>Entrar</span>
                }
            </button>
        </div>
    </div>
</div>

<style>
    .login-page {
        min-height: 85vh;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        padding: 3rem;
    }

    .login-card {
        display: flex;
        width: 860px;
        border-radius: 12px;
        overflow: hidden;
    }

    .login-card-left {
        background: linear-gradient(180deg, #0d6efd, #6610f2);
        width: 40%;
    }

    .login-card-body {
        background: white;
        width: 60%;
    }

    @@media (max-width: 768px) {
        .login-card {
            flex-direction: column;
            width: 100%;
        }

        .login-card-left {
            width: 100%;
            padding: 2rem 1rem;
        }

        .login-card-body {
            width: 100%;
        }
    }
</style>

@code {
    private string username = "";
    private string password = "";
    private bool isProcessing = false;
    private string? errorMessage;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Por favor ingresa usuario y contraseña.";
            return;
        }

        isProcessing = true;
        errorMessage = null;

        try
        {
            // ✅ Login es síncrono y retorna Usuario?
            var result = AuthService.Login(username, password);

            if (result != null)
            {
                // Redirige según el rol del usuario
                var ruta = result.Rol switch
                {
                    "Administrador" => "/dashboard",
                    "Porteria" => "/porteria",
                    "Residente" => "/residente",
                    _ => "/dashboard"
                };

                Navigation.NavigateTo(ruta);
            }
            else
            {
                errorMessage = "Usuario o contraseña incorrectos.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al iniciar sesión: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }

        // Necesario para que Blazor re-renderice el estado final
        await Task.CompletedTask;
    }
}
}